# Rust build artifacts
/target/
**/*.rs.bk
# NOTE: Cargo.lock IS committed. The plugin must build under rustc 1.75 to
# match the validator, which requires pinning several transitive deps below
# their latest (MSRV-incompatible) releases. Those pins only survive in the
# lockfile, so dropping it reintroduces the build failure.

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.env

# Logs
*.log
logs/

# Build artifacts
*.so
*.dylib
*.dll

# Test artifacts
*.profraw
coverage/

# Docker
docker-compose.override.yml

# Local configuration (don't commit secrets)
config.json
config.local.json
config/prometheus.yml
config/grafana/

# Benchmark results
criterion/

# Node
node_modules/

# Keys, keypairs, secrets (never commit)
*.key
*.pem
*.p12
*.pfx
keypair*.json
*-keypair.json
secrets/
secrets.*
.secrets/
id_rsa*
id_ed25519*
